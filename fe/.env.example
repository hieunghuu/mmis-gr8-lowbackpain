# Địa chỉ API mà trình duyệt gọi. Mặc định "/api/v1" (cùng origin, Vite proxy lúc dev, BE phục vụ file tĩnh lúc demo).
# Nếu BE chạy khác origin thì đặt đầy đủ, ví dụ http://192.168.1.10:8000/api/v1 và bật CORS ở BE.
VITE_API_BASE_URL=/api/v1

# Chỉ dùng cho `npm run dev`: Vite chuyển tiếp /api sang đâu (BE thật hoặc mock).
VITE_PROXY_TARGET=http://localhost:8000
